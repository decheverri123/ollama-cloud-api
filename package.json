{
  "name": "ollama-cloud-api",
  "version": "2.0.0",
  "description": "Missing API for Ollama Cloud models: live usage tiers, scraped benchmarks, task recommendations, comparisons, and leaderboards",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "type": "module",
  "bin": {
    "ollama-cloud-api": "./dist/index.js",
    "ollama-proxy": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test": "tsx --test 'test/**/*.test.ts'",
    "prepublishOnly": "pnpm build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "ollama",
    "ollama-cloud",
    "ollama-api",
    "benchmarks",
    "model-router",
    "ai",
    "llm",
    "proxy",
    "scalar",
    "openapi"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decheverri123/ollama-cloud-api.git"
  },
  "bugs": {
    "url": "https://github.com/decheverri123/ollama-cloud-api/issues"
  },
  "homepage": "https://github.com/decheverri123/ollama-cloud-api#readme",
  "author": "Daniel Echeverri",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
